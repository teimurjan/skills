# Copy to `.env.local` and fill in. Nothing here is secret in the repo sense — this file is
# committed — but every value it names is, so `.env.local` is gitignored.
#
# The app runs without most of these. Supabase unset means sign-in is unavailable and the
# API answers 401; the biller unset means the web checkout never opens; Apple unset means
# purchase verification is a 503. Each is a legible "not configured yet" state rather than
# a crash, which is what lets a fresh clone boot.

# ---------------------------------------------------------------------------
# Supabase — the database and the identity provider
# ---------------------------------------------------------------------------
# The new publishable/secret key format, not the legacy anon/service_role JWTs.
# The publishable key is client-safe and ships in the iOS binary too
# (ios/Config/Production.xcconfig). The secret key bypasses RLS and must never leave here:
# every table in this project has RLS on with no policies, so the secret key is the only
# thing that can read them, and the explicit `.eq("user_id", …)` in each query is the
# access check.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Apple — App Store purchases and server notifications
# ---------------------------------------------------------------------------
APPLE_BUNDLE_ID=com.example.appname
# The numeric app id from App Store Connect. Also used by the site's App Store badge as
# NEXT_PUBLIC_APP_STORE_ID below.
APPLE_APP_APPLE_ID=

# Apple's root CAs, base64 DER, comma-separated. `SignedDataVerifier` refuses to verify a
# transaction without them, so an empty value is what makes /api/purchase answer 503
# rather than accepting an unverified receipt.
# Download from https://www.apple.com/certificateauthority/ and:
#   base64 -i AppleIncRootCertificate.cer | tr -d '\n'
APPLE_ROOT_CERTS_BASE64=

# App Store Server API key (Users and Access → Integrations → In-App Purchase). This is
# NOT the same key as appstore/fastlane/AuthKey_*.p8, which is for editing metadata and
# carries different permissions — mixing them up produces a confusing 401.
APPLE_INAPP_KEY_ID=
APPLE_INAPP_ISSUER_ID=
# The .p8's contents, raw PEM or base64. Newlines survive either way.
APPLE_INAPP_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Paddle — web purchases
# ---------------------------------------------------------------------------
# Which Paddle this deployment talks to. It does double duty: it picks the API host *and*
# it is written onto every `paddle_entitlements` row and compared on every read, so a
# sandbox subscription bought from a developer's machine can never grant paid access in
# production. Defaults to sandbox — production has to be stated.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
# From the webhook destination in Paddle. Per-environment, which is what makes the
# `environment` column above trustworthy rather than merely declared.
PADDLE_WEBHOOK_SECRET=

# The browser half. The client token can only open checkouts, and price ids are public by
# design — both ship to the page. Keep NEXT_PUBLIC_PADDLE_ENVIRONMENT in step with
# PADDLE_ENVIRONMENT: the two disagreeing shows up only as a checkout that silently never
# opens.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_YEARLY=
# A one-time price on the same product — the lifetime unlock. The paywall offers it only while
# the flag is "true"; to end the offer, turn the flag off and keep the id, so an open checkout
# still grants.
NEXT_PUBLIC_PADDLE_PRICE_LIFETIME=
NEXT_PUBLIC_PADDLE_LIFETIME_ON_SALE=false

# ---------------------------------------------------------------------------
# Resend — the abandoned-checkout reminder and the welcome email after a web purchase
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# On a domain verified in Resend, e.g. "Appname <hello@appname.example>".
RESEND_FROM=
# Printed in every footer — CAN-SPAM requires a physical address. Nothing sends without it.
EMAIL_POSTAL_ADDRESS=
# Vercel sends it as the bearer on every cron call; set it in the project, not only here.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Meta — ad measurement
# ---------------------------------------------------------------------------
# The browser pixel. `proxy.ts` withholds it entirely for EEA/UK/CH readers, so this being
# set does not mean it loads for everyone.
NEXT_PUBLIC_META_PIXEL_ID=
# The Conversions API, server-side. Use a *development* dataset locally and keep it
# disconnected from any ad account — a test purchase landing in the dataset an active
# campaign optimizes against teaches the algorithm to buy the wrong people, and that is
# expensive and slow to undo.
META_DATASET_ID=
# Must be scoped to the dataset, not a full `ads_management` token. A leaked dataset token
# can send events; a leaked ads token can spend money.
META_CAPI_ACCESS_TOKEN=
# Optional. Set while wiring CAPI up so events land in Test Events instead of the live
# dataset, then remove it — leaving it set means production conversions are never counted.
META_TEST_EVENT_CODE=
META_GRAPH_API_VERSION=

# ---------------------------------------------------------------------------
# Everything else
# ---------------------------------------------------------------------------
# The site's own origin, used for CAPI's `event_source_url` and the funnel's success
# redirect. Must be set in Vercel; the default only makes local development work.
SITE_URL=https://appname.example

# Amplitude write key. Same project as the iOS app — events are separated by their
# `appname_web_` / `appname_server_` / `appname_` prefixes, not by project.
NEXT_PUBLIC_AMPLITUDE_API_KEY=

# The numeric App Store id. Unset means the App Store badge renders nothing at all, which
# is right before the app is approved: a badge that 404s is worse than no badge.
NEXT_PUBLIC_APP_STORE_ID=

# ---------------------------------------------------------------------------
# iOS client — not read by this app, documented here so the list is in one place
# ---------------------------------------------------------------------------
# The origin the app calls is API_BASE_URL in ios/Config/*.xcconfig, not here; those files
# also carry SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY. The Google iOS OAuth client id is
# the exception: it is hardcoded in ios/Appname/Info.plist as GIDClientID with its
# reversed-id URL scheme, because the SDK reads that key itself and the value is the same in
# every configuration.
#
# Google sign-in also needs the Google provider enabled in the Supabase dashboard, with the
# *web* client id and secret — and the iOS client id added to its "Authorized Client IDs",
# or GoTrue rejects the id_token the app sends.
