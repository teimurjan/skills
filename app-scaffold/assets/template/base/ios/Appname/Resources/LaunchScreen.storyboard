<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="24765" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="Lnc-00-vcr">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24743"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--View Controller-->
        <scene sceneID="Lnc-00-scn">
            <objects>
                <viewController id="Lnc-00-vcr" sceneMemberID="viewController">
                    <!-- The mark over the wordmark, centred as one group on the canvas. SplashScreen
                         draws the same two images at the same sizes, so the handoff to SwiftUI is
                         nothing moving. Keep the sizes, the 20pt gap and the colour in step with
                         SplashScreen.Layout and Palette.canvas. -->
                    <view key="view" contentMode="scaleToFill" id="Lnc-00-vew">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="AppMark" translatesAutoresizingMaskIntoConstraints="NO" id="Lnc-00-mrk">
                                <rect key="frame" x="112.5" y="314" width="168" height="168"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="168" id="Lnc-01-cst"/>
                                    <constraint firstAttribute="width" constant="168" id="Lnc-02-cst"/>
                                </constraints>
                            </imageView>
                            <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LaunchWordmark" translatesAutoresizingMaskIntoConstraints="NO" id="Lnc-00-wrd">
                                <rect key="frame" x="107.33333333333333" y="502" width="178.33333333333334" height="37.333333333333336"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="37.333333333333336" id="Lnc-05-cst"/>
                                    <constraint firstAttribute="width" constant="178.33333333333334" id="Lnc-06-cst"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="Lnc-00-saf"/>
                        <color key="backgroundColor" red="0.94901960784313721" green="0.92549019607843142" blue="0.8901960784313725" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="Lnc-00-mrk" firstAttribute="centerX" secondItem="Lnc-00-saf" secondAttribute="centerX" id="Lnc-03-cst"/>
                            <constraint firstItem="Lnc-00-mrk" firstAttribute="centerY" secondItem="Lnc-00-saf" secondAttribute="centerY" constant="-28.666666666666668" id="Lnc-04-cst"/>
                            <constraint firstItem="Lnc-00-wrd" firstAttribute="centerX" secondItem="Lnc-00-saf" secondAttribute="centerX" id="Lnc-07-cst"/>
                            <constraint firstItem="Lnc-00-wrd" firstAttribute="top" secondItem="Lnc-00-mrk" secondAttribute="bottom" constant="20" id="Lnc-08-cst"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="Lnc-00-rsp" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="53" y="375"/>
        </scene>
    </scenes>
    <resources>
        <image name="AppMark" width="168" height="168"/>
        <image name="LaunchWordmark" width="178.33332824707031" height="37.333332061767578"/>
    </resources>
</document>
